# Secrets
.env
keys/

# No data in Git: raw and intermediate data stay local, and processed data and
# the reports that name participants are versioned by DVC (dvc.yaml, dvc.lock).
# The summary reports with no participant IDs are kept in Git to be read.
data/raw/*
data/interim/*
# ?*, not *: the same files to git, but DVC's git library lets * match the folder itself, and DVC
# doesn't look for .dvc files in a folder it thinks is ignored, so it never pulled the split.
data/processed/?*
data/reports/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# DVC's pointer files (a hash, no data), such as the patient split's
!data/processed/*.dvc
!data/reports/.gitkeep
!data/reports/bias_report.md
*.part
*.zip

# Logs
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.venv/
