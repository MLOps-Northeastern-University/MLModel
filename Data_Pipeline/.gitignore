# Secrets
.env
keys/

# No data in Git: raw and intermediate data stay local, and processed data and
# the reports that name participants are versioned by DVC (dvc.yaml, dvc.lock).
# The summary reports with no participant IDs are kept in Git to be read.
data/raw/*
data/interim/*
data/processed/*
data/reports/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep
!data/reports/cleaning_summary.json
!data/reports/bias_report.md
*.part
*.zip

# Logs
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.venv/
