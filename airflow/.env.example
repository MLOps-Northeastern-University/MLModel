# Copy to .env and fill in. Never commit .env.

# This machine's checkout of the MLModel repo. The data and the model's outputs live under it, and
# the tasks' containers mount them from here. A path Docker on this machine understands:
#   Linux (the GPU machine):   /srv/mednova/MLModel
#   Docker Desktop on Windows: /run/desktop/mnt/host/d/path/to/MLModel
HOST_REPO=/srv/mednova/MLModel
# harnet10's weights folder (the local copy of OxWearables/ssl-wearables). Never in git or an image.
HARNET_DIR=/srv/mednova/harnet10

# The pipelines' images. CI pushes them to Artifact Registry tagged with the commit.
DATA_IMAGE=data-pipeline:latest
MODEL_IMAGE=model-pipeline:latest
# 1 on the GPU machine (needs NVIDIA's container toolkit).
MODEL_GPU=0

# MLflow. On a laptop, the model pipeline's own MLflow (Model_Pipeline/docker-compose.yaml), as the
# containers reach it; on the GPU machine, the team's MLflow on Cloud Run with Google ID tokens.
MLFLOW_TRACKING_URI=http://host.docker.internal:5001
MODEL_MLFLOW_GOOGLE_AUTH=0
# The registry: a local folder in artifacts/ when unset, or gs://team17-mlops-neu-models.
MODEL_REGISTRY=

# Airflow's own user and login.
AIRFLOW_UID=50000
DOCKER_GID=0
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Alerts (for Gmail, use an app password).
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
